CREATE TABLE IF NOT EXISTS chat_messages (
    id TEXT PRIMARY KEY,
    session_id TEXT NOT NULL,
    role TEXT NOT NULL,
    content TEXT NOT NULL,
    created_at TEXT AS kotlin.time.Instant NOT NULL,
    is_outdated INTEGER DEFAULT 0,
    edit_parent_id TEXT,
    is_edited INTEGER DEFAULT 0,
    synced_at TEXT AS kotlin.time.Instant,
    is_failed INTEGER DEFAULT 0,
    input_tokens INTEGER,
    output_tokens INTEGER,
    total_tokens INTEGER,
    duration_ms INTEGER,
    is_bookmarked INTEGER DEFAULT 0,
    content_json TEXT,
    used_resource_collection_ids TEXT DEFAULT '[]',
    FOREIGN KEY (session_id) REFERENCES chat_sessions (id) ON DELETE CASCADE,
    FOREIGN KEY (edit_parent_id) REFERENCES chat_messages (id) ON DELETE SET NULL
);

CREATE INDEX IF NOT EXISTS idx_messages_session_created ON chat_messages (session_id, created_at);
CREATE INDEX IF NOT EXISTS idx_messages_session_outdated_created ON chat_messages (session_id, is_outdated, created_at);

insertMessage:
INSERT INTO chat_messages (id, session_id, role, content, created_at, is_outdated, edit_parent_id, is_edited, is_failed, input_tokens, output_tokens, total_tokens, duration_ms, content_json, synced_at)
VALUES (:id, :sessionId, :role, :content, :createdAt, :isOutdated, :editParentId, :isEdited, :isFailed, :inputTokens, :outputTokens, :totalTokens, :durationMs, :contentJson, :syncedAt);

selectBySessionOrderedAsc:
SELECT * FROM chat_messages WHERE session_id = :sessionId ORDER BY created_at ASC;

countByRole:
SELECT COUNT(*) FROM chat_messages WHERE role = :role;

countByRoleSince:
SELECT COUNT(*) FROM chat_messages WHERE role = :role AND is_outdated = 0 AND created_at > :since;

selectRecentActiveGlobalByRole:
SELECT * FROM chat_messages WHERE role = :role AND is_outdated = 0 ORDER BY created_at DESC LIMIT :limit;

selectBySessionAscFromStart:
SELECT * FROM chat_messages WHERE session_id = :sessionId ORDER BY created_at ASC LIMIT :limit;

selectBySessionDescFromEnd:
SELECT * FROM chat_messages WHERE session_id = :sessionId ORDER BY created_at DESC LIMIT :limit;

selectBySessionAfterCursorAsc:
SELECT * FROM chat_messages WHERE session_id = :sessionId AND created_at > :cursor ORDER BY created_at ASC LIMIT :limit;

selectBySessionBeforeCursorDesc:
SELECT * FROM chat_messages WHERE session_id = :sessionId AND created_at < :cursor ORDER BY created_at DESC LIMIT :limit;

searchBySessionOrdered:
SELECT * FROM chat_messages WHERE session_id = :sessionId AND LOWER(content) LIKE :pattern ORDER BY created_at ASC LIMIT :limit;

searchGlobalDesc:
SELECT cm.* FROM chat_messages cm
WHERE LOWER(cm.content) LIKE :pattern
  AND (:startTime IS NULL OR cm.created_at >= :startTime)
  AND (:endTime IS NULL OR cm.created_at <= :endTime)
  AND (:projectId IS NULL OR cm.session_id IN (SELECT id FROM chat_sessions WHERE project_id = :projectId))
ORDER BY cm.created_at DESC
LIMIT :limit;

searchGlobalAsc:
SELECT cm.* FROM chat_messages cm
WHERE LOWER(cm.content) LIKE :pattern
  AND (:startTime IS NULL OR cm.created_at >= :startTime)
  AND (:endTime IS NULL OR cm.created_at <= :endTime)
  AND (:projectId IS NULL OR cm.session_id IN (SELECT id FROM chat_sessions WHERE project_id = :projectId))
ORDER BY cm.created_at ASC
LIMIT :limit;

markOutdated:
UPDATE chat_messages SET is_outdated = 1 WHERE id = :id;

selectCreatedAtById:
SELECT created_at FROM chat_messages WHERE id = :id;

markOutdatedFrom:
UPDATE chat_messages SET is_outdated = 1 WHERE session_id = :sessionId AND created_at >= :fromTimestamp;

selectRecentActive:
SELECT * FROM chat_messages WHERE session_id = :sessionId AND is_outdated = 0 ORDER BY created_at DESC LIMIT :limit;

updateContent:
UPDATE chat_messages SET content = :content, is_edited = 1, content_json = NULL WHERE id = :id;

selectIdsBySession:
SELECT id FROM chat_messages WHERE session_id = :sessionId;

deleteBySession:
DELETE FROM chat_messages WHERE session_id = :sessionId;

deleteByIds:
DELETE FROM chat_messages WHERE id IN :ids;

upsertMessage:
INSERT INTO chat_messages (id, session_id, role, content, created_at, is_outdated, edit_parent_id, is_edited, is_failed, input_tokens, output_tokens, total_tokens, duration_ms, content_json, synced_at)
VALUES (:id, :sessionId, :role, :content, :createdAt, :isOutdated, :editParentId, :isEdited, :isFailed, :inputTokens, :outputTokens, :totalTokens, :durationMs, :contentJson, :syncedAt);

selectMessageById:
SELECT * FROM chat_messages WHERE id = :id;

updateMessageFromServer:
UPDATE chat_messages SET
  session_id = :sessionId, role = :role, content = :content, created_at = :createdAt,
  is_outdated = :isOutdated, edit_parent_id = :editParentId, is_edited = :isEdited, is_failed = :isFailed,
  input_tokens = :inputTokens, output_tokens = :outputTokens, total_tokens = :totalTokens,
  duration_ms = :durationMs, content_json = :contentJson, synced_at = :syncedAt
WHERE id = :id;


markSyncedMessage:
UPDATE chat_messages SET synced_at = :syncedAt WHERE id = :id;

selectUnsynced:
SELECT * FROM chat_messages WHERE is_outdated = 0 AND synced_at IS NULL ORDER BY created_at ASC LIMIT :limit;

selectUnsyncedBySession:
SELECT * FROM chat_messages WHERE session_id = :sessionId AND is_outdated = 0 AND synced_at IS NULL ORDER BY created_at ASC LIMIT :limit;

selectBookmarkFlag:
SELECT is_bookmarked FROM chat_messages WHERE id = :id;

updateBookmark:
UPDATE chat_messages SET is_bookmarked = :isBookmarked WHERE id = :id;

selectBookmarkedBySession:
SELECT * FROM chat_messages WHERE session_id = :sessionId AND is_bookmarked = 1 ORDER BY created_at ASC;

selectAllBookmarked:
SELECT * FROM chat_messages WHERE is_bookmarked = 1 ORDER BY created_at DESC;

selectAllBookmarkedWithSessions:
SELECT
  cm.id AS msg_id, cm.session_id AS msg_session_id, cm.role AS msg_role, cm.content AS msg_content,
  cm.created_at AS msg_created_at, cm.is_outdated AS msg_is_outdated, cm.edit_parent_id AS msg_edit_parent_id,
  cm.is_edited AS msg_is_edited, cm.synced_at AS msg_synced_at, cm.is_failed AS msg_is_failed,
  cm.input_tokens AS msg_input_tokens, cm.output_tokens AS msg_output_tokens, cm.total_tokens AS msg_total_tokens,
  cm.duration_ms AS msg_duration_ms, cm.is_bookmarked AS msg_is_bookmarked, cm.content_json AS msg_content_json,
  cs.id AS session_id, cs.title AS session_title, cs.created_at AS session_created_at,
  cs.updated_at AS session_updated_at, cs.project_id AS session_project_id,
  cs.directive_id AS session_directive_id, cs.is_starred AS session_is_starred
FROM chat_messages cm
INNER JOIN chat_sessions cs ON cm.session_id = cs.id
WHERE cm.is_bookmarked = 1
ORDER BY cs.updated_at DESC, cm.created_at ASC;

selectBookmarkCountsBySession:
SELECT session_id, COUNT(*) AS cnt FROM chat_messages WHERE is_bookmarked = 1 GROUP BY session_id;
