CREATE TABLE IF NOT EXISTS user_phrase_suggestions (
    id TEXT PRIMARY KEY,
    profile_id TEXT NOT NULL,
    category_key TEXT NOT NULL,
    phrase TEXT NOT NULL,
    usage_count INTEGER NOT NULL DEFAULT 1,
    created_at TEXT AS kotlin.time.Instant NOT NULL,
    updated_at TEXT AS kotlin.time.Instant NOT NULL,
    FOREIGN KEY (profile_id) REFERENCES user_profiles(id) ON DELETE CASCADE,
    UNIQUE(profile_id, category_key, phrase)
);
CREATE INDEX IF NOT EXISTS idx_user_phrase_suggestions_profile ON user_phrase_suggestions(profile_id);
CREATE INDEX IF NOT EXISTS idx_user_phrase_suggestions_category ON user_phrase_suggestions(profile_id, category_key);

-- All rows for a profile (all categories, all variants). Dataset is tiny by design
-- (capped at 20 categories x 5 variants = 100 rows/profile — see PhraseHabitRefreshService
-- and UserPhraseSuggestionRepository), so grouping/eviction logic is done in Kotlin rather
-- than with more elaborate per-category SQL.
selectByProfileId:
SELECT * FROM user_phrase_suggestions WHERE profile_id = :profileId ORDER BY category_key, usage_count DESC, updated_at DESC;

insertVariant:
INSERT INTO user_phrase_suggestions (id, profile_id, category_key, phrase, usage_count, created_at, updated_at)
VALUES (:id, :profileId, :categoryKey, :phrase, 1, :createdAt, :updatedAt);

-- Bumps an existing variant's usage/recency when a refresh re-confirms the same phrase text.
touchVariant:
UPDATE user_phrase_suggestions SET usage_count = usage_count + 1, updated_at = :updatedAt WHERE id = :id;

deleteById:
DELETE FROM user_phrase_suggestions WHERE id = :id;

deleteByProfileId:
DELETE FROM user_phrase_suggestions WHERE profile_id = :profileId;

-- Independent of suggestion rows — a successful extraction attempt (even one returning no
-- habits) must still advance the gate in PhraseHabitRefreshService. MAX(updated_at) over
-- user_phrase_suggestions alone never moves for an empty result, bypassing the cooldown/
-- message-count gate on every subsequent message. See PhraseHabitRefreshService.attemptRefresh.
CREATE TABLE IF NOT EXISTS phrase_refresh_checkpoint (
    profile_id TEXT PRIMARY KEY NOT NULL,
    last_refreshed_at TEXT AS kotlin.time.Instant NOT NULL,
    FOREIGN KEY (profile_id) REFERENCES user_profiles(id) ON DELETE CASCADE
);

upsertRefreshCheckpoint:
INSERT OR REPLACE INTO phrase_refresh_checkpoint (profile_id, last_refreshed_at)
VALUES (:profileId, :lastRefreshedAt);

selectRefreshCheckpoint:
SELECT last_refreshed_at FROM phrase_refresh_checkpoint WHERE profile_id = :profileId;

deleteRefreshCheckpointByProfileId:
DELETE FROM phrase_refresh_checkpoint WHERE profile_id = :profileId;

